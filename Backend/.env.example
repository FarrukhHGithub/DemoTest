# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Primary connection string (Vercel convention — used in db.js and Agenda)
MONGODB_URI=mongodb+srv://FarrukhBalay:FarrukhBalay@cluster0.kqaf8ub.mongodb.net/

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ─── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g.:
#   https://admin.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# ─── Google OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full URL to redirect to after a successful Google login (your frontend)
GOOGLE_OAUTH_SUCCESS_REDIRECT=

# ─── SMTP / Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: service shorthand used by nodemailer (e.g. gmail). Leave blank if using host/port above.
EMAIL_SERVICE=
# The clinic's notification inbox — used as the "To" address for internal alerts
CLINIC_NOTIFY_EMAIL=

# ─── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ─── SendGrid ───────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────────────
# Set to "production" on Vercel (it does this automatically via the Vercel dashboard)
NODE_ENV=development
PORT=8800
